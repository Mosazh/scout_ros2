<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 引入惯性宏 -->
  <xacro:include filename="$(find scout_description)/urdf/common_inertia.xacro" />

  <!-- 雷达 + IMU 宏 -->
  <xacro:macro name="sensors_xacro" params="laser_cylinder_xyz laser_xyz laser_name imu_xyz imu_name">

    <!-- 雷达支撑杆 -->
    <link name="laser_cylinder_link">
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.10" radius="0.01"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.10" radius="0.01"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.01" r="0.01" h="0.10"/>
    </link>

    <joint name="laser_cylinder_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_cylinder_link"/>
      <origin xyz="${laser_cylinder_xyz}"/>
    </joint>

    <!-- 雷达本体 -->
    <link name="laser_link">
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.02" radius="0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.02" radius="0.02"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.03" r="0.02" h="0.02"/>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="laser_cylinder_link"/>
      <child link="laser_link" />
      <origin xyz="${laser_xyz}" />
    </joint>

    <gazebo reference="laser_link">
      <sensor name="${laser_name}" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.3</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </gazebo>

    <!-- IMU -->
    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
        <material name="blue">
          <color rgba="0 0 1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.02" w="0.05" h="0.05" d="0.05"/>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${imu_xyz}"/>
    </joint>

    <gazebo reference="imu_link">
      <sensor name="${imu_name}" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
      </sensor>
    </gazebo>

    <!-- 驱动所有传感器的插件 -->
    <!-- <gazebo>
      <plugin name="ignition::gazebo::systems::Sensors"
              filename="libignition-gazebo6-sensors-system.so"/>
    </gazebo> -->

  </xacro:macro>

</robot>
