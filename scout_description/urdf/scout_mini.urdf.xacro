<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scout_mini">

  <!-- 参数配置 -->
  <xacro:property name="wheel_mass" value="3"/>
  <xacro:property name="wheel_ixx" value="0.7171"/>
  <xacro:property name="wheel_iyy" value="0.7171"/>
  <xacro:property name="wheel_izz" value="0.1361"/>
  <xacro:property name="base_mass" value="30"/>
  <xacro:property name="mesh_pkg" value="package://scout_description/meshes"/>

  <!-- 底盘 -->
  <link name="base_link">
    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="2.288641" ixy="0" ixz="0" iyy="5.103976" iyz="0" izz="3.431465"/>
    </inertial>
    <visual>
      <origin rpy="1.57 0 -1.57" xyz="0 0 0.20199"/>
      <geometry>
        <mesh filename="${mesh_pkg}/scout_mini_base_link2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57 0 -1.57" xyz="0 0 0.20199"/>
      <geometry>
        <mesh filename="${mesh_pkg}/scout_mini_base_link2.dae"/>
      </geometry>
    </collision>
  </link>

  <!-- 定义 wheel 宏 -->
  <xacro:macro name="wheel" params="name parent xyz rpy axis">
    <link name="${name}_link">
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_pkg}/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_pkg}/wheel.dae"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
    </joint>
  </xacro:macro>

  <!-- 前左轮 -->
  <xacro:wheel name="front_left_wheel" parent="base_link"
               xyz="0.2319755 0.2082515 0.100998" rpy="-1.57 0 0" axis="0 0 -1"/>
  <!-- 后左轮 -->
  <xacro:wheel name="rear_left_wheel" parent="base_link"
               xyz="-0.2319755 0.2082515 0.100998" rpy="-1.57 0 0" axis="0 0 -1"/>
  <!-- 前右轮 -->
  <xacro:wheel name="front_right_wheel" parent="base_link"
               xyz="0.2319755 -0.2082515 0.100998" rpy="1.57 0 0" axis="0 0 -1"/>
  <!-- 后右轮 -->
  <xacro:wheel name="rear_right_wheel" parent="base_link"
               xyz="-0.2319755 -0.2082515 0.100998" rpy="1.57 0 0" axis="0 0 -1"/>

  <!-- ros2_control 配置 -->
  <ros2_control name="scout_mini_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- gazebo 插件 -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find scout_control)/config/scout_mini_controller.yaml</parameters>
    </plugin>
  </gazebo>

  <xacro:include filename="$(find scout_description)/urdf/sensor/lidar.xacro"/>
  <xacro:lidar_sensor parent_link="base_link" xyz="0.0 0.0 0.45"/>

  <xacro:include filename="$(find scout_description)/urdf/sensor/rgbd_camera.xacro"/>
  <xacro:rgbd_camera_sensor parent_link="base_link" xyz= "0.24 0.0 0.32"/>

  <xacro:include filename="$(find scout_description)/urdf/sensor/imu.xacro"/>
  <xacro:imu_sensor parent_link="base_link" xyz= "0.0 0.0 0.15"/>

</robot>
